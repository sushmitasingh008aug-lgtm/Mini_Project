# ==============================================================================
# Automatic Block Planning System (ABPS) - Production Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this template to .env:
#    cp .env.example .env
# 2. Update POSTGRES_PASSWORD with a strong random secret before deployment:
#    openssl rand -hex 24
# 3. DO NOT commit the populated .env file to version control.
# ==============================================================================

# --- Database Configuration (PostgreSQL 16 Alpine) ---
POSTGRES_DB=block_planning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword_change_me_in_production
# Host port mapping for PostgreSQL (leave as 5432 or change if conflicting with local pg)
POSTGRES_PORT=5432

# --- Application Server Configuration (Go Fiber API + Vite React SPA) ---
# Host port mapping for web UI and REST API
PORT=3000
# Internal/external port mapping for Python CP-SAT Solver and ML engine
PYTHON_PORT=8765

# Optimization horizon in days (default: 7 days)
HORIZON_DAYS=7

# Python binary name for solver engine within the container
PYTHON_BIN=python3
PYTHONUNBUFFERED=1

# --- Frontend API Endpoint ---
# Default "/api" proxies/routes requests on the same origin
VITE_API_URL=/api
